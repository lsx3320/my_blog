---
interface Props {
  title?: string;
}

const { title = '日记' } = Astro.props;
---

<!-- 密码门 -->
<div id="diary-gate" class="flex items-center justify-center py-24 bg-[#f2f2f7]">
  <form
    id="diary-gate-form"
    class="w-full max-w-sm bg-white rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_8px_24px_rgba(0,0,0,0.08)] border border-[#e5e5ea] p-8 text-center"
  >
    <div class="w-14 h-14 mx-auto mb-5 rounded-full bg-[#1c1c1e] flex items-center justify-center">
      <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    </div>
    <h2 class="font-display font-semibold text-xl text-[#1c1c1e] mb-1">私人{title}</h2>
    <p class="font-sans text-sm text-[#8a8a8e] mb-7">我现在在哪里？</p>
    <input
      id="diary-answer"
      type="text"
      placeholder="输入答案，回车进入"
      autocomplete="off"
      class="w-full px-4 py-2.5 rounded-xl bg-[#f2f2f7] border border-transparent text-[#1c1c1e] font-sans text-sm text-center focus:outline-none focus:ring-2 focus:ring-[#0a84ff]/40 placeholder:text-[#c7c7cc]"
    />
    <button
      id="diary-unlock"
      type="submit"
      class="mt-5 w-full py-2.5 rounded-xl bg-[#0a84ff] text-white text-sm font-medium hover:opacity-90 active:scale-[0.98] transition-all"
    >
      进入
    </button>
    <p id="diary-error" class="hidden mt-4 text-xs text-[#ff3b30] font-sans">答案不对，再想想～</p>
  </form>
</div>

<!-- 内容（解锁后显示） -->
<div id="diary-app" class="hidden">
  <slot />
</div>

<script is:inline data-astro-rerun>
  // 密码门：我现在在哪里？→ 武汉
  // 状态用 localStorage 持久保存：登录一次，长期有效（跨标签页/跨会话）
  const ANSWER = '武汉';
  const KEY = 'diary_unlocked';
  const gate = document.getElementById('diary-gate');
  const app = document.getElementById('diary-app');
  const input = document.getElementById('diary-answer');
  const err = document.getElementById('diary-error');
  const form = document.getElementById('diary-gate-form');

  function isUnlocked() {
    try {
      // 兼容旧 sessionStorage 状态；新版统一存 localStorage
      if (localStorage.getItem(KEY) === '1') return true;
      if (sessionStorage.getItem(KEY) === '1') {
        localStorage.setItem(KEY, '1');
        return true;
      }
    } catch { /* ignore */ }
    return false;
  }

  function markUnlocked() {
    try { localStorage.setItem(KEY, '1'); } catch { /* ignore */ }
  }

  function enter() {
    if (!gate || !app) return;
    // 先记录状态（立即生效）
    markUnlocked();
    // 平滑过渡：密码门淡出 → 内容淡入
    gate.style.transition = 'opacity 0.22s ease';
    gate.style.opacity = '0';
    setTimeout(() => {
      gate.classList.add('hidden');
      gate.style.opacity = '';
      app.classList.remove('hidden');
      app.classList.add('diary-app-in');
    }, 200);
  }

  // 已登录则直接进入
  function applyUnlocked() {
    if (isUnlocked() && gate && app) {
      gate.classList.add('hidden');
      app.classList.remove('hidden');
      app.classList.add('diary-app-in');
      return true;
    }
    return false;
  }

  // 页面加载时
  if (!applyUnlocked()) {
    setTimeout(() => input?.focus(), 80);
  }

  // View Transitions 每次导航后兜底检查
  if (!window.__diaryGateBound) {
    window.__diaryGateBound = true;
    document.addEventListener('astro:page-load', () => {
      setTimeout(applyUnlocked, 0);
    });
  }

  function fail() {
    err?.classList.remove('hidden');
    if (form) {
      form.classList.remove('login-shake');
      void form.offsetWidth;
      form.classList.add('login-shake');
      form.addEventListener('animationend', () => form.classList.remove('login-shake'), { once: true });
    }
    // 答错自动清空，聚焦等待重输
    if (input) {
      input.value = '';
      input.focus();
    }
  }

  function tryUnlock() {
    if (input && input.value.trim() === ANSWER) {
      err?.classList.add('hidden');
      enter();
      return true;
    }
    return false;
  }

  // 表单提交：回车与「进入」按钮都走这里
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!tryUnlock()) fail();
  });

  // 输入法组词中的回车不提交；普通回车提交表单
  input?.addEventListener('keydown', (e) => {
    if (e.isComposing || e.keyCode === 229) return;
    if (e.key === 'Enter') {
      e.preventDefault();
      form?.requestSubmit();
    }
  });

  // 输入变化时自动校验：中文选字上屏后立即判断，答对即进（无需再按回车/点按钮）
  input?.addEventListener('input', () => {
    if (tryUnlock()) return;
  });
</script>

<style>
  @keyframes login-shake {
    10%, 90% { transform: translateX(-1px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-4px); }
    40%, 60% { transform: translateX(4px); }
  }
  .login-shake { animation: login-shake 0.4s ease; }

  @keyframes diaryFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .diary-app-in { animation: diaryFadeIn 0.3s ease; }
</style>
