---
import { ArrowUpRight, Github, Mail } from 'lucide-astro';
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page-wrap">
    <div class="footer-main">
      <div><a href="/" class="footer-name">后生仔<span>Lu Shixiao</span></a><p>纸上得来终觉浅，绝知此事要躬行。</p></div>
      <nav aria-label="页脚导航"><a href="/posts">文章</a><a href="/gallery">相册</a><a href="/timeline">成长记录</a><a href="/about">关于我</a></nav>
      <div class="footer-contact">
        <a href="https://github.com/lsx3320" target="_blank" rel="noopener noreferrer"><Github size={17} /> GitHub <ArrowUpRight size={13} /></a>
        <a href="mailto:15527759825@163.com"><Mail size={17} /> 写封邮件</a>
      </div>
    </div>
    <div class="footer-bottom"><span>&copy; {currentYear} 卢仕潇 · 于此间，留下一点痕迹。</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">鄂ICP备2024037507号</a></div>
  </div>
</footer>
<style>
  .site-footer { margin-top: 64px; border-top: 1px solid var(--color-border); background: var(--color-muted); padding-block: 42px 28px; }
  .footer-main { display: flex; justify-content: space-between; gap: 32px; padding-bottom: 36px; }
  .footer-name { font-size: 23px; font-weight: 600; display: flex; gap: 14px; align-items: baseline; }
  .footer-name span { font-family: 'Fraunces', Georgia, serif; font-style: italic; font-size: 18px; font-weight: 400; color: var(--color-primary); }
  .footer-main p { font-size: 13px; color: var(--color-muted-foreground); margin-top: 10px; }
  nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 30px; align-content: start; font-size: 13px; }
  .footer-contact { display: flex; flex-direction: column; gap: 12px; font-size: 13px; }
  .footer-contact a { display: flex; align-items: center; gap: 8px; }
  a:hover { color: var(--color-primary); }
  .footer-bottom { border-top: 1px solid var(--color-border); padding-top: 22px; display: flex; justify-content: space-between; gap: 16px; font-size: 11px; color: var(--color-muted-foreground); }
  @media (max-width: 700px) { .footer-main { flex-wrap: wrap; gap: 28px; } .footer-main > div:first-child { width: 100%; } .footer-contact { margin-right: 15px; } .footer-bottom { flex-direction: column; padding-bottom: 35px; } }
</style>
