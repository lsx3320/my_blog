---
import type { TimelineEvent } from '../data/timeline';

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<div class="relative pl-9">
  <!-- Vertical rule -->
  <div class="absolute left-[3px] top-2 bottom-2 w-px bg-[var(--color-border)]" aria-hidden="true"></div>

  {events.map((event) => (
    <div class="relative mb-10 last:mb-0">
      <!-- Dot on the rule -->
      <span class="absolute -left-9 top-1.5 w-[7px] h-[7px] rounded-full bg-[var(--color-primary)]" aria-hidden="true"></span>

      <div class="group -m-2 p-5 rounded-md border border-transparent hover:border-[var(--color-border)] hover:bg-[var(--color-card)] transition-colors">
        <div class="flex items-center gap-3 mb-2">
          {event.category && (
            <span class="text-xs font-medium tracking-wide text-[var(--color-primary)]">{event.category}</span>
          )}
          {event.date && (
            <span class="text-xs text-[var(--color-muted-foreground)]">{event.date}</span>
          )}
        </div>
        <h3 class="font-sans font-semibold text-lg mb-2 text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors">
          {event.title}
        </h3>
        <div class="text-sm text-[var(--color-muted-foreground)] leading-relaxed space-y-2">
          {event.description.split('\n').map(line => (
            line.trim() && <p>{line.trim()}</p>
          ))}
        </div>
        {event.image && (
          <img src={event.image} alt={event.title} class="mt-3 rounded-md w-full h-auto" loading="lazy" decoding="async" />
        )}
      </div>
    </div>
  ))}
</div>
