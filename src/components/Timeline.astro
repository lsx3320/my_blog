---
import type { TimelineEvent } from '../data/timeline';

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;

// 按年份分组（保留数据顺序，无年份的归入「其他」）
const groups: { year: string; events: TimelineEvent[] }[] = [];
for (const event of events) {
  const m = event.date.match(/(\d{4})/);
  const year = m ? m[1] : '其他';
  const last = groups[groups.length - 1];
  if (last && last.year === year) {
    last.events.push(event);
  } else {
    groups.push({ year, events: [event] });
  }
}
---

<div class="space-y-16">
  {groups.map(group => (
    <section>
      <!-- 年份章标题 -->
      <div class="flex items-baseline gap-4 mb-8">
        <h3 class="font-display font-bold text-4xl text-[var(--color-primary)] tabular-nums tracking-tight">
          {group.year}
        </h3>
        <div class="h-px flex-1 bg-[var(--color-border)]" aria-hidden="true"></div>
      </div>

      <div class="space-y-9">
        {group.events.map(event => (
          <div class="pl-5 border-l border-[var(--color-border)] group">
            <div class="flex items-center gap-3 font-sans text-xs mb-2">
              {event.category && (
                <span class="text-[var(--color-primary)] font-medium tracking-wide">{event.category}</span>
              )}
              {event.date && <span class="text-[var(--color-muted-foreground)]">{event.date}</span>}
            </div>
            <h4 class="font-display font-semibold text-lg leading-snug mb-2 group-hover:text-[var(--color-primary)] transition-colors">
              {event.title}
            </h4>
            <div class="text-sm text-[var(--color-muted-foreground)] leading-relaxed space-y-1.5">
              {event.description.split('\n').map(line => (
                line.trim() && <p>{line.trim()}</p>
              ))}
            </div>
            {event.image && (
              <img src={event.image} alt={event.title} class="mt-4 w-full h-auto border border-[var(--color-border)]" loading="lazy" decoding="async" />
            )}
          </div>
        ))}
      </div>
    </section>
  ))}
</div>
