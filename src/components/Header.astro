---
import { Search, Sun, Moon, Menu, X, ArrowUpRight } from 'lucide-astro';
const navItems: { label: string; href: string; reload?: boolean }[] = [
  { label: '首页', href: '/' }, { label: '文章', href: '/posts' },
  { label: '朋友圈', href: '/moments' }, { label: '相册', href: '/gallery' },
  { label: '随笔', href: '/diary' }, { label: '中转', href: '/links' },
  // 插件看板是独立静态页（不是 Astro 路由），必须整页跳转，交给客户端路由会被拼成坏页面
  { label: '插件', href: '/dsh-board/', reload: true },
  { label: '关于', href: '/about' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
---
<header class="site-header">
  <site-navigation>
    <nav class="page-wrap header-inner" aria-label="主导航">
      <a href="/" class="wordmark" aria-label="后生仔，首页">
        <svg class="wordmark-stamp" viewBox="0 0 70 78" width="35" height="39" aria-hidden="true">
          <path fill="currentColor" fill-rule="evenodd" d="M4.50 0.00H65.50A4.50 4.50 0 0 1 70.00 4.50V73.50A4.50 4.50 0 0 1 65.50 78.00H4.50A4.50 4.50 0 0 1 0.00 73.50V4.50A4.50 4.50 0 0 1 4.50 0.00ZM4.50 2.00H65.50A2.50 2.50 0 0 1 68.00 4.50V73.50A2.50 2.50 0 0 1 65.50 76.00H4.50A2.50 2.50 0 0 1 2.00 73.50V4.50A2.50 2.50 0 0 1 4.50 2.00Z" />
          <path fill="currentColor" d="M15.8 50.1C15.27 50.1 13.76 50.1 13.76 50.1V51.17C14.74 51.27 15.42 51.37 16.05 51.85C17.07 52.53 17.36 56.42 16.68 61.33C16.78 62.88 17.36 63.76 18.23 63.76C19.89 63.76 20.86 62.49 20.96 60.45C21.15 56.47 19.74 54.18 19.69 52C19.64 50.83 19.94 49.32 20.32 47.87C20.96 45.58 24.36 34.84 26.11 29.11L25.23 28.91C17.8 47.38 17.8 47.38 17.02 49.08C16.53 50.1 16.34 50.1 15.8 50.1ZM13.08 30.86 12.6 31.29C14.54 32.66 16.78 35.13 17.36 37.27C20.76 39.31 23 32.41 13.08 30.86ZM16.05 19.68 15.61 20.17C17.89 21.67 20.76 24.44 21.64 26.78C25.28 28.77 27.18 21.48 16.05 19.68ZM37.67 49.76 33.49 47.87C33.1 52.05 31.99 56.18 30.43 59.09L31.26 59.53C33.44 57.2 34.95 53.75 35.83 50.44C36.75 50.64 37.38 50.3 37.67 49.76ZM43.31 48.4 42.63 48.64C43.89 51.32 45.3 55.45 45.35 58.56C47.78 61.04 50.5 55.06 43.31 48.4ZM32.76 24.15H25.48L25.82 25.56H32.76V29.16H33.25C34.61 29.16 35.63 28.72 35.63 28.43V25.56H45.3V29.06H45.79C47.39 29.06 48.17 28.43 48.17 28.23V25.56H55.75C56.43 25.56 56.82 25.32 56.97 24.78C55.56 23.42 53.22 21.67 53.22 21.67L51.28 24.15H48.17V20.75C49.34 20.6 49.77 20.07 49.87 19.39L45.3 19V24.15H35.63V20.75C36.8 20.6 37.19 20.07 37.28 19.39L32.76 19ZM31.4 46.26 27.03 45.78V50.98C27.03 54.96 26.3 60.02 22.41 63.42L23.05 64C28.73 60.7 29.75 55.16 29.8 51.02V47.48C30.97 47.38 31.31 46.89 31.4 46.26ZM54.29 46.6 49.68 46.12V63.76H50.21C51.33 63.76 52.54 63.13 52.54 62.74V47.87C53.76 47.72 54.2 47.28 54.29 46.6ZM54.34 34.7 52.59 36.93H51.57V32.7C52.25 32.66 52.88 32.32 53.13 32.02L49.87 29.45L48.32 31.1H41.56V28.77C42.73 28.62 43.21 28.18 43.31 27.46L38.55 26.92V31.1H27.95L28.39 32.51H38.55V36.93H24.84L25.23 38.34H38.55V42.96H27.66L28.1 44.42H38.69V63.85H39.13C40.39 63.85 41.32 63.27 41.37 63.08V44.42H48.7V45.78H49.14C50.11 45.78 51.52 45.1 51.57 44.8V38.34H56.19C56.87 38.34 57.31 38.1 57.4 37.56C56.24 36.3 54.34 34.7 54.34 34.7ZM41.56 42.96V38.34H48.7V42.96ZM41.56 32.51H48.7V36.93H41.56Z" />
        </svg>
        <span>后生仔</span>
      </a>
      <ul class="desktop-nav">
        {navItems.map(item => <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} {...(item.reload ? { 'data-astro-reload': true } : {})}>{item.label}</a></li>)}
      </ul>
      <div class="header-actions">
        <a href="/posts#search" class="icon-button" aria-label="搜索文章" title="搜索文章"><Search /></a>
        <button id="theme-toggle" class="icon-button" aria-label="切换主题" title="切换主题"><Moon class="dark:hidden" /><Sun class="hidden dark:block" /></button>
        <button id="mobile-menu-toggle" class="icon-button menu-toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu" title="打开菜单"><Menu class="menu-open-icon" /><X class="menu-close-icon" /></button>
      </div>
    </nav>
    <nav id="mobile-menu" class="mobile-nav" aria-label="移动端导航" hidden>
      <ul class="page-wrap">
        {navItems.map(item => <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} {...(item.reload ? { 'data-astro-reload': true } : {})}>{item.label}<ArrowUpRight size={16} /></a></li>)}
      </ul>
    </nav>
  </site-navigation>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--color-background); border-bottom: 1px solid var(--color-border); }
  site-navigation { display: block; }
  .header-inner { min-height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .wordmark { display: flex; align-items: center; gap: 12px; flex-shrink: 0; font-size: 20px; font-weight: 650; line-height: 1.3; }
  .wordmark-stamp { width: 35px; height: 39px; display: block; flex: none; color: var(--color-primary); }
  .wordmark small { display: block; font-size: 12px; font-weight: 400; color: var(--color-muted-foreground); margin-top: 4px; }
  .desktop-nav { display: flex; gap: 15px; font-size: 14px; align-self: stretch; align-items: stretch; }
  .desktop-nav li { display: flex; }
  .desktop-nav a { display: flex; align-items: center; position: relative; padding-inline: 12px; color: var(--color-muted-foreground); }
  .desktop-nav a:hover, a[aria-current="page"] { color: var(--color-primary); }
  .desktop-nav a[aria-current="page"]::after { content: ''; position: absolute; bottom: 19px; left: 0; right: 0; height: 2px; background: var(--color-primary); }
  .header-actions { display: flex; gap: 2px; }
  .menu-toggle { display: none; }
  .mobile-nav { border-top: 1px solid var(--color-border); padding-block: 12px 20px; }
  .mobile-nav a { display: flex; justify-content: space-between; align-items: center; padding: 12px 4px; font-size: 15px; }
  .mobile-nav li + li { border-top: 1px solid var(--color-border); }
  .menu-close-icon, [aria-expanded="true"] .menu-open-icon { display: none; }
  [aria-expanded="true"] .menu-close-icon { display: block; }
  @media (max-width: 980px) { .desktop-nav { gap: 18px; } .wordmark small { display: none; } }
  @media (max-width: 800px) { .desktop-nav { display: none; } .menu-toggle { display: inline-flex; } .header-inner { min-height: 68px; gap: 10px; } .wordmark { font-size: 18px; gap: 9px; } }
  @media (min-width: 801px) { .mobile-nav { display: none; } }
  @media (max-width: 380px) { .header-actions .icon-button { width: 36px; } }
</style>
<script>
  class SiteNavigation extends HTMLElement {
    connectedCallback() {
      const toggle = this.querySelector<HTMLButtonElement>('#mobile-menu-toggle')!;
      const menu = this.querySelector<HTMLElement>('#mobile-menu')!;
      const themeButton = this.querySelector<HTMLButtonElement>('#theme-toggle')!;
      const setMenu = (open: boolean) => {
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
        toggle.title = open ? '关闭菜单' : '打开菜单';
      };
      const syncLabel = () => {
        const label = document.documentElement.classList.contains('dark') ? '切换到浅色主题' : '切换到深色主题';
        themeButton.setAttribute('aria-label', label);
        themeButton.title = label;
      };
      toggle.onclick = () => setMenu(Boolean(menu.hidden));
      this.onkeydown = (event) => {
        if (event.key === 'Escape' && !menu.hidden) { setMenu(false); toggle.focus(); }
      };
      menu.onclick = (event) => { if ((event.target as Element).closest('a')) setMenu(false); };
      themeButton.onclick = () => {
        const dark = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.classList.toggle('light', !dark);
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
        syncLabel();
      };
      syncLabel();
    }
  }
  if (!customElements.get('site-navigation')) customElements.define('site-navigation', SiteNavigation);
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('theme-toggle');
    const label = document.documentElement.classList.contains('dark') ? '切换到浅色主题' : '切换到深色主题';
    button?.setAttribute('aria-label', label);
    button?.setAttribute('title', label);
  });
</script>
