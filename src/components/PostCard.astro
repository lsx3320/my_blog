---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
  slug: string;
}

const { title, description, pubDate, category, tags, slug } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group h-full">
  <a href={`/posts/${slug}`} class="block h-full p-6 bg-[var(--color-card)] border border-[var(--color-border)] rounded-md hover:border-[var(--color-primary)] transition-colors">
    <div class="flex items-center gap-3 text-xs text-[var(--color-muted-foreground)] mb-3">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <span class="w-px h-3 bg-[var(--color-border)]" aria-hidden="true"></span>
      <span class="text-[var(--color-primary)]">{category}</span>
    </div>
    <h3 class="font-sans font-semibold text-lg mb-2 group-hover:text-[var(--color-primary)] transition-colors">
      {title}
    </h3>
    <p class="text-sm text-[var(--color-muted-foreground)] leading-relaxed mb-4 line-clamp-2">
      {description}
    </p>
    <div class="flex flex-wrap gap-2">
      {tags.map(tag => (
        <span class="px-2 py-0.5 text-xs border border-[var(--color-border)] rounded-sm text-[var(--color-muted-foreground)]">
          {tag}
        </span>
      ))}
    </div>
  </a>
</article>
