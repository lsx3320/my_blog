---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const allDiaries = (await getCollection('diaries')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="日记">
  <!-- Apple Notes 纸面 -->
  <div class="bg-[#fdf6e3] border-b border-[#e8dfc0] min-h-[80vh]">

    <!-- 工具条 -->
    <div class="border-b border-[#e8dfc0] bg-[#f6edd0]">
      <div class="max-w-3xl mx-auto px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[#8a8270]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="font-sans text-sm text-[#5a5340]">日记</span>
        </div>
        <span id="diary-today" class="font-sans text-xs text-[#8a8270]"></span>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-6 py-12">

      <!-- 密码门 -->
      <div id="diary-gate" class="flex flex-col items-center justify-center py-24 text-center">
        <svg class="w-8 h-8 text-[#8a8270] mb-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <p class="font-sans text-base text-[#3a3526] mb-8">我现在在哪里？</p>
        <input
          id="diary-answer"
          type="text"
          placeholder="输入答案"
          autocomplete="off"
          class="w-64 bg-transparent border-b border-[#c9bf9d] py-2 text-center text-[#3a3526] font-sans text-base focus:outline-none focus:border-[#c23b22] placeholder:text-[#b5ab8c]"
        />
        <button
          id="diary-unlock"
          class="mt-8 px-8 py-2 rounded-md bg-[#3a3526] text-[#fdf6e3] text-sm font-medium hover:bg-[#c23b22] transition-colors"
        >
          进入
        </button>
        <p id="diary-error" class="hidden mt-4 text-xs text-[#d64545] font-sans">答案不对，再想想～</p>
      </div>

      <!-- 日记内容（解锁后显示） -->
      <div id="diary-content" class="hidden">

        <!-- 书写区 -->
        <div class="mb-12">
          <div class="flex items-center gap-3 mb-6">
            <input
              id="diary-mood"
              placeholder="心情，如：平静"
              class="w-36 bg-transparent border-b border-[#d8cfae] pb-1 font-sans text-sm text-[#5a5340] focus:outline-none focus:border-[#c23b22] placeholder:text-[#b5ab8c]"
            />
            <input
              id="diary-weather"
              placeholder="天气，如：晴"
              class="w-36 bg-transparent border-b border-[#d8cfae] pb-1 font-sans text-sm text-[#5a5340] focus:outline-none focus:border-[#c23b22] placeholder:text-[#b5ab8c]"
            />
            <div class="flex-1"></div>
            <button
              id="diary-save"
              class="px-6 py-1.5 rounded-md bg-[#3a3526] text-[#fdf6e3] text-sm font-medium hover:bg-[#c23b22] transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              保存
            </button>
          </div>

          <input
            id="diary-title"
            placeholder="标题"
            class="w-full bg-transparent font-sans font-semibold text-2xl text-[#3a3526] placeholder:text-[#c4baa0] focus:outline-none mb-5"
          />
          <textarea
            id="diary-body"
            placeholder="写点什么……"
            rows="10"
            class="w-full bg-transparent resize-y font-sans text-[16px] leading-loose text-[#3a3526] focus:outline-none placeholder:text-[#c4baa0]"
          ></textarea>

          <div class="mt-3 flex items-center justify-between">
            <span id="diary-status" class="font-sans text-xs text-[#8a8270]"></span>
          </div>
        </div>

        <!-- 历史日记 -->
        <div>
          <div class="flex items-baseline justify-between mb-6">
            <h2 class="font-sans font-semibold text-base text-[#5a5340]">过往</h2>
            <p class="font-sans text-xs text-[#8a8270]">{allDiaries.length} 篇</p>
          </div>
          <div class="space-y-4">
            {allDiaries.map(async (d) => {
              const { Content } = await render(d);
              const formattedDate = d.data.date.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                weekday: 'long',
              });
              return (
                <article class="bg-[#fffdf3] rounded-lg shadow-sm p-5 border border-[#efe6c8]">
                  <div class="flex items-baseline justify-between gap-4 mb-1.5">
                    <h3 class="font-sans font-semibold text-[#3a3526] truncate">
                      {d.data.title || formattedDate}
                    </h3>
                    <time class="font-sans text-xs text-[#8a8270] shrink-0">{formattedDate}</time>
                  </div>
                  {d.data.mood && (
                    <p class="font-sans text-xs text-[#b08a3e] mb-1.5">{d.data.mood}</p>
                  )}
                  <div class="text-[15px] text-[#5a5340] leading-relaxed line-clamp-5">
                    <Content />
                  </div>
                </article>
              );
            })}

            {allDiaries.length === 0 && (
              <div class="text-center py-16 text-[#8a8270] font-sans">还没有日记，写第一篇吧。</div>
            )}
          </div>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  // 密码门：我现在在哪里？→ 武汉
  const ANSWER = '武汉';
  const gate = document.getElementById('diary-gate');
  const content = document.getElementById('diary-content');
  const input = document.getElementById('diary-answer');
  const btn = document.getElementById('diary-unlock');
  const err = document.getElementById('diary-error');

  function unlock() {
    if (gate && content) {
      gate.classList.add('hidden');
      content.classList.remove('hidden');
      sessionStorage.setItem('diary_unlocked', '1');
      // 解锁后直接聚焦正文，进入书写状态
      const body = document.getElementById('diary-body');
      if (body) body.focus();
    }
  }

  // 本会话已通过则直接进入
  if (sessionStorage.getItem('diary_unlocked') === '1') {
    unlock();
  }

  btn?.addEventListener('click', () => {
    if (input && input.value.trim() === ANSWER) {
      err?.classList.add('hidden');
      unlock();
    } else {
      err?.classList.remove('hidden');
      input?.focus();
    }
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') btn?.click();
  });

  // 工具条：今日日期
  const todayEl = document.getElementById('diary-today');
  if (todayEl) {
    todayEl.textContent = new Date().toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      weekday: 'long',
    });
  }

  // 提交到 GitHub（经本站 Pages Function /api/diary）
  const saveBtn = document.getElementById('diary-save');
  const statusEl = document.getElementById('diary-status');

  saveBtn?.addEventListener('click', async () => {
    const title = document.getElementById('diary-title').value.trim();
    const mood = document.getElementById('diary-mood').value.trim();
    const weather = document.getElementById('diary-weather').value.trim();
    const body = document.getElementById('diary-body').value.trim();

    if (!body) {
      statusEl.textContent = '先写点什么再保存吧';
      return;
    }

    saveBtn.disabled = true;
    statusEl.textContent = '正在提交到 GitHub…';

    try {
      const res = await fetch('/api/diary', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, mood, weather, body }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '提交失败');

      statusEl.textContent = '已提交，站点正在自动重建，约 1-2 分钟后可见';
      document.getElementById('diary-title').value = '';
      document.getElementById('diary-mood').value = '';
      document.getElementById('diary-weather').value = '';
      document.getElementById('diary-body').value = '';
    } catch (e) {
      statusEl.textContent = '提交失败：' + e.message;
    } finally {
      saveBtn.disabled = false;
    }
  });
</script>
