---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { timelineEvents } from '../data/timeline';

const allPosts = (await getCollection('posts')).filter(post => !post.data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="首页">
  <!-- Hero section -->
  <section class="relative">
    <div class="max-w-5xl mx-auto px-6 py-28 md:py-40 text-center">
      <p class="text-xs font-medium tracking-[0.28em] uppercase text-[var(--color-muted-foreground)] mb-8">
        Welcome to my space
      </p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-sans font-semibold leading-[1.15] tracking-tight mb-8">
        于此间记录点滴思考
        <br />
        <span class="text-[var(--color-primary)]">既为自省，亦为留痕</span>
      </h1>
      <p class="text-lg md:text-xl text-[var(--color-muted-foreground)] leading-relaxed mb-14 max-w-2xl mx-auto">
        编程心得、项目经验，以及生活中那些值得记录的瞬间。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/posts"
          class="inline-flex items-center px-7 py-3 bg-[var(--color-foreground)] text-[var(--color-background)] rounded-md font-medium text-sm hover:bg-[var(--color-primary)] transition-colors"
        >
          阅读文章
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="/gallery"
          class="inline-flex items-center px-7 py-3 border border-[var(--color-border)] rounded-md font-medium text-sm text-[var(--color-foreground)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-colors"
        >
          浏览相册
        </a>
      </div>
      <div class="mt-16 flex justify-center">
        <div class="w-12 h-[2px] bg-[var(--color-primary)]" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- Timeline section -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-sans font-semibold tracking-tight mb-4">时间轴</h2>
      <p class="text-[var(--color-muted-foreground)] max-w-xl mx-auto">
        记录生活中的重要时刻，留住那些值得回忆的瞬间
      </p>
    </div>
    <div class="max-w-3xl mx-auto">
      <Timeline events={timelineEvents} />
    </div>
  </section>

  <!-- Recent posts preview -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-2xl font-sans font-semibold tracking-tight">最新文章</h2>
      <a href="/posts" class="text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-primary)] transition-colors">
        查看全部 &rarr;
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          category={post.data.category}
          tags={post.data.tags}
          slug={post.id}
        />
      ))}
    </div>
  </section>
</BaseLayout>
