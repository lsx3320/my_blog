---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection } from 'astro:content';
import { timelineEvents } from '../data/timeline';

const allPosts = (await getCollection('posts')).filter(post => !post.data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout title="首页">
  <!-- 封面 -->
  <section class="border-b border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
      <!-- Masthead -->
      <div class="relative">
        <h1 class="font-display font-bold text-6xl md:text-8xl tracking-tight leading-none">
          后生仔
        </h1>
        <p class="mt-5 text-lg md:text-xl text-[var(--color-muted-foreground)] font-serif">
          于此间记录点滴思考 · 既为自省，亦为留痕
        </p>
        <div class="mt-10 flex items-center gap-4">
          <div class="h-px flex-1 bg-[var(--color-border)]"></div>
          <span class="tag text-[var(--color-muted-foreground)]">第壹卷 · 贰零贰陆 · 技术与生活的纸上笔记</span>
          <div class="h-px flex-1 bg-[var(--color-border)]"></div>
        </div>
        <!-- 竖排点缀 -->
        <span
          class="hidden lg:block absolute right-0 top-0 font-serif text-sm tracking-[0.3em] text-[var(--color-muted-foreground)]"
          style="writing-mode: vertical-rl"
          aria-hidden="true"
        >
          于此间 · 记录点滴思考
        </span>
      </div>

      <!-- 封面主体：左图右要目 -->
      <div class="mt-14 grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-12">
        <!-- 封面图 -->
        <figure class="md:col-span-3">
          <a href="/gallery" class="block group">
            <img
              src="/gallery/故宫.webp"
              alt="故宫"
              class="w-full h-[320px] md:h-[440px] object-cover border border-[var(--color-border)]"
              loading="eager"
              decoding="async"
            />
            <figcaption class="mt-3 flex items-center justify-between font-sans text-xs text-[var(--color-muted-foreground)]">
              <span>封面图 · 故宫</span>
              <span class="group-hover:text-[var(--color-primary)] transition-colors">画册 &rarr;</span>
            </figcaption>
          </a>
        </figure>

        <!-- 本期要目 -->
        <aside class="md:col-span-2">
          <h2 class="tag text-[var(--color-primary)] mb-4">本期要目</h2>
          <ol class="border-t border-[var(--color-border)]">
            {recentPosts.map((post, i) => (
              <li class="border-b border-[var(--color-border)] py-4 group">
                <a href={`/posts/${post.id}`} class="block">
                  <div class="flex items-baseline gap-3">
                    <span class="font-display font-semibold text-[var(--color-primary)] tabular-nums">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <div class="min-w-0">
                      <h3 class="font-display font-semibold text-lg leading-snug group-hover:text-[var(--color-primary)] transition-colors line-clamp-2">
                        {post.data.title}
                      </h3>
                      <p class="mt-1 font-sans text-xs text-[var(--color-muted-foreground)]">
                        {post.data.category} · {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })}
                      </p>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ol>
          <a href="/posts" class="mt-5 inline-block font-sans text-xs text-[var(--color-muted-foreground)] hover:text-[var(--color-primary)] transition-colors">
            全部篇目 &rarr;
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- 编年史 -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-baseline justify-between mb-12">
      <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight">编年史</h2>
      <p class="font-sans text-xs text-[var(--color-muted-foreground)]">二〇二一 — 二〇二六 · 摘录</p>
    </div>
    <div class="max-w-3xl">
      <Timeline events={timelineEvents} />
    </div>
  </section>
</BaseLayout>
