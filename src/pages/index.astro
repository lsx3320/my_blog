---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ArrowUpRight, ArrowRight, MapPin, Code2, Camera, BookOpen, MoveDown } from 'lucide-astro';
import { timelineEvents } from '../data/timeline';
const posts = (await getCollection('posts')).filter(post => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 4);
const technicalPosts = ['transformer-guide', 'resnet-guide', 'agent-guide'].map(id => posts.find(post => post.id === id)).filter(Boolean);
const selectedMemories = [timelineEvents[1], timelineEvents[2], timelineEvents[5]];
const lake = '/gallery/ppyq/slmh/f709402f3861a10eb4749ede2e8127dd.webp';
const photos = [
  { src: lake, title: '赛里木湖', note: '新疆 · 路上的风景', href: '/gallery#travel' },
  { src: '/gallery/故宫.webp', title: '故宫', note: '北京 · 一眼千年', href: '/gallery#memories' },
  { src: '/gallery/合照.webp', title: '合照', note: '一些人，一些记得住的日子', href: '/gallery#together' },
];
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---
<BaseLayout title="首页" image={lake}>
  <section class="journal-cover" aria-labelledby="cover-title">
    <img class="cover-image" src={lake} alt="赛里木湖的蓝色湖水、雪山与湖畔" width="1706" height="1279" loading="eager" fetchpriority="high" decoding="async" />
    <div class="cover-shade"></div>
    <div class="page-wrap cover-inner">
      <div class="cover-top"><span>LU SHIXIAO / PERSONAL JOURNAL</span><span class="cover-place"><MapPin size={14} /> 新疆 · 赛里木湖</span></div>
      <div class="cover-copy">
        <p class="cover-intro">你好，我是卢仕潇。</p>
        <h1 id="cover-title">后生仔<span class="cover-dot">。</span></h1>
        <p class="cover-description">以代码观世界，以迭代修人生。<br />写一点技术，也记下生活经过的样子。</p>
      </div>
      <div class="cover-bottom"><a href="#latest">翻开最近的记录 <MoveDown size={16} /></a><span class="cover-handwriting">Life, in progress.</span><a href="/gallery">我的相册 <ArrowUpRight size={16} /></a></div>
    </div>
  </section>

  <section class="intro-band">
    <div class="page-wrap intro-inner">
      <p>于此间记录点滴思考，<span>既为自省，亦为留痕。</span></p>
      <div class="intro-links"><a href="/posts?category=技术"><Code2 size={17} />技术探索</a><a href="/moments"><BookOpen size={17} />生活片段</a><a href="/gallery"><Camera size={17} />光影收藏</a></div>
    </div>
  </section>

  <section id="latest" class="page-wrap section-space">
    <div class="section-heading"><div><span class="eyebrow">RECENTLY WRITTEN</span><h2>最近写下的</h2></div><a class="text-link" href="/posts">全部 {posts.length} 篇文章 <ArrowUpRight /></a></div>
    <div class="journal-grid">
      <div class="recent-list">
        {recentPosts.map(post => (
          <article class="recent-post">
            <a href={'/posts/' + post.id}>
              <div class="post-meta"><span class:list={['category', post.data.category === '技术' && 'is-tech']}>{post.data.category}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
              <h3>{post.data.title}<ArrowUpRight size={19} /></h3>
              <p>{post.data.description}</p>
            </a>
          </article>
        ))}
      </div>
      <aside class="journal-sidebar">
        <div class="about-note"><span class="eyebrow"><span class="status-dot"></span> 保持好奇，持续生长</span><h3>一个做技术的人，<br />也认真过日子。</h3><p>从 Transformer 到 AI 智能体，从武汉的街头到新疆的湖边。这里放着我的尝试、见闻，和慢慢想明白的事。</p><a class="text-link" href="/about">多认识我一点 <ArrowRight /></a></div>
        <div class="reading-note"><span class="eyebrow"><Code2 size={16} /> 从这里读起</span><h3>把 AI 讲明白</h3>{technicalPosts.map(post => post && <a href={'/posts/' + post.id}><span>{post.data.title.split('：')[0]}</span><ArrowUpRight size={16} /></a>)}</div>
      </aside>
    </div>
  </section>

  <section class="photo-band">
    <div class="page-wrap section-space">
      <div class="section-heading"><div><span class="eyebrow">AWAY FROM THE SCREEN</span><h2>屏幕之外</h2><p>总有一些瞬间，值得按下快门。</p></div><a href="/gallery" class="text-link">走进相册 <ArrowUpRight /></a></div>
      <div class="photo-strip">{photos.map(photo => <a href={photo.href} class="photo-memory"><figure><img src={photo.src} alt={photo.title} loading="lazy" decoding="async" width="800" height="600" /><figcaption><div><h3>{photo.title}</h3><p>{photo.note}</p></div><ArrowUpRight size={18} /></figcaption></figure></a>)}</div>
    </div>
  </section>

  <section class="page-wrap section-space">
    <div class="section-heading"><div><span class="eyebrow">ALONG THE WAY</span><h2>来时的路</h2><p>人会在经历里，慢慢成为自己。</p></div><a href="/timeline" class="text-link">完整成长记录 <ArrowUpRight /></a></div>
    <div class="memory-grid">{selectedMemories.map(event => <a href="/timeline" class="memory"><span class="memory-date">{event.date}</span><h3>{event.title}</h3><p>{event.description.split('\n')[0]}</p><span class="text-link">读这段故事 <ArrowRight /></span></a>)}</div>
  </section>
</BaseLayout>
<style>
  .journal-cover { position: relative; height: min(550px, 62svh); min-height: 310px; overflow: hidden; color: white; background: #366e87; }
  .cover-image { position: absolute; width: 100%; height: 100%; object-fit: cover; object-position: center 5%; }
  .cover-shade { position: absolute; inset: 0; background: rgb(8 29 35 / .27); }
  .cover-inner { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding-block: 26px; }
  .cover-top { display: flex; justify-content: space-between; gap: 20px; font-size: 11px; }
  .cover-place { display: flex; align-items: center; gap: 7px; }
  .cover-copy { padding-bottom: 5px; text-shadow: 0 2px 14px rgb(0 26 42 / .35); }
  .cover-intro { font-size: 15px; margin-bottom: 9px; }
  .cover-copy h1 { font-family: 'Songti SC', 'STSong', serif; font-weight: 600; font-size: 90px; line-height: 1.2; }
  .cover-dot { color: #f3b6a3; }
  .cover-description { margin-top: 22px; font-size: 16px; line-height: 1.9; }
  .cover-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 12px; }
  .cover-bottom a { display: flex; gap: 12px; align-items: center; }
  .cover-bottom a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .cover-handwriting { font-family: 'Fraunces', Georgia, serif; font-style: italic; font-size: 23px; }
  .intro-band { border-bottom: 1px solid var(--color-border); }
  .intro-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 92px; }
  .intro-inner > p { font-family: var(--font-serif); font-size: 15px; }
  .intro-inner > p span { color: var(--color-muted-foreground); }
  .intro-links { display: flex; flex-wrap: wrap; gap: 30px; font-size: 12px; color: var(--color-muted-foreground); }
  .intro-links a { display: flex; align-items: center; gap: 8px; }
  .intro-links a:hover { color: var(--color-primary); }
  .intro-links svg { color: var(--color-primary); }
  .journal-grid { display: grid; grid-template-columns: minmax(0, 1fr) 285px; gap: 64px; }
  .recent-post { border-top: 1px solid var(--color-border); }
  .recent-post:last-child { border-bottom: 1px solid var(--color-border); }
  .recent-post > a { display: block; padding-block: 24px; }
  .post-meta { display: flex; align-items: center; gap: 16px; font-size: 11px; color: var(--color-muted-foreground); margin-bottom: 11px; }
  .category { color: var(--color-accent); }
  .category.is-tech { color: var(--color-primary); }
  .recent-post h3 { font-size: 20px; line-height: 1.55; display: flex; align-items: baseline; justify-content: space-between; gap: 24px; }
  .recent-post h3 svg { flex-shrink: 0; color: var(--color-muted-foreground); }
  .recent-post a:hover h3 { color: var(--color-primary); }
  .recent-post p { margin-top: 10px; color: var(--color-muted-foreground); font-size: 13px; line-height: 1.8; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .journal-sidebar { border-left: 1px solid var(--color-border); padding-left: 28px; }
  .about-note { padding-block: 8px 28px; border-bottom: 1px solid var(--color-border); }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary); }
  .about-note h3 { font-family: var(--font-serif); font-size: 23px; line-height: 1.7; margin-block: 20px 16px; }
  .about-note p { font-size: 13px; line-height: 1.9; color: var(--color-muted-foreground); margin-bottom: 22px; }
  .reading-note { padding-top: 25px; }
  .reading-note h3 { font-size: 18px; margin-bottom: 15px; }
  .reading-note > a { display: flex; gap: 12px; align-items: center; justify-content: space-between; padding-block: 12px; border-bottom: 1px solid var(--color-border); font-size: 12px; }
  .reading-note > a svg { flex-shrink: 0; color: var(--color-primary); }
  .reading-note > a:hover { color: var(--color-primary); }
  .photo-band { background: var(--color-muted); }
  .photo-strip { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 25px; }
  .photo-memory { min-width: 0; }
  .photo-memory img { width: 100%; height: 240px; object-fit: cover; border-radius: 4px; transition: opacity .2s; }
  .photo-memory:hover img { opacity: .88; }
  figcaption { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding-top: 16px; }
  figcaption h3 { font-size: 16px; }
  figcaption p { font-size: 11px; margin-top: 6px; color: var(--color-muted-foreground); }
  figcaption svg { color: var(--color-primary); flex-shrink: 0; }
  .memory-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .memory { border-top: 2px solid var(--color-border); padding-top: 20px; }
  .memory-date { font-family: var(--font-mono); font-size: 12px; color: var(--color-accent); }
  .memory h3 { font-size: 18px; margin-block: 14px 10px; }
  .memory p { color: var(--color-muted-foreground); font-size: 13px; line-height: 1.9; margin-bottom: 20px; }
  .memory:hover { border-color: var(--color-primary); }
  @media (max-width: 900px) { .intro-inner { flex-direction: column; align-items: start; gap: 14px; padding-block: 20px; } .journal-grid { gap: 30px; grid-template-columns: minmax(0,1fr) 240px; } .journal-sidebar { padding-left: 24px; } .photo-memory img { height: 190px; } }
  @media (max-width: 700px) {
    .journal-cover { min-height: 350px; }
    .cover-image { object-position: 55% center; }
    .cover-inner { padding-block: 20px; }
    .cover-top { font-size: 9px; }
    .cover-top > span:first-child { max-width: 140px; }
    .cover-place { align-items: start; }
    .cover-copy h1 { font-size: 62px; }
    .cover-intro { font-size: 13px; }
    .cover-description { font-size: 14px; margin-top: 16px; }
    .cover-handwriting { display: none; }
    .intro-inner > p { font-size: 13px; }
    .intro-links { gap: 22px; font-size: 11px; }
    .journal-grid { grid-template-columns: minmax(0,1fr); gap: 30px; }
    .journal-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; border-left: 0; padding-left: 0; }
    .about-note { border-bottom: 0; padding-block: 0; }
    .about-note h3 { font-size: 19px; margin-top: 14px; }
    .reading-note { padding-top: 0; }
    .recent-post h3 { font-size: 18px; gap: 15px; }
    .photo-strip { grid-template-columns: 1fr; gap: 28px; }
    .photo-memory img { height: auto; aspect-ratio: 16 / 10; }
    .memory-grid { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 380px) { .journal-sidebar { grid-template-columns: 1fr; } .intro-links { gap: 15px; } .cover-copy h1 { font-size: 54px; } }
</style>
