---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map(post => post.data.category))];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit' }).replace('/', '.');
---

<BaseLayout title="目录">
  <section class="max-w-4xl mx-auto px-6 py-16 md:py-20">
    <div class="flex items-baseline justify-between mb-3">
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight">目 录</h1>
      <p class="tag text-[var(--color-muted-foreground)]">第壹卷 · 贰零贰陆 · 共 {posts.length} 篇</p>
    </div>
    <p class="text-[var(--color-muted-foreground)] font-serif mb-12">
      记录技术探索与生活感悟的文字空间
    </p>

    <!-- 分类索引 -->
    <div class="flex flex-wrap gap-x-6 gap-y-2 mb-8 font-sans text-[13px]">
      <button class="category-filter text-[var(--color-primary)]" data-category="all">全部</button>
      {categories.map(cat => (
        <button
          class="category-filter text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] transition-colors"
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- 篇目索引 -->
    <ol class="border-t border-[var(--color-border)]">
      {posts.map((post, i) => (
        <li class="post-item border-b border-[var(--color-border)] reveal" style={`transition-delay: ${Math.min(i, 8) * 40}ms`} data-category={post.data.category}>
          <a
            href={`/posts/${post.id}`}
            class="flex items-baseline gap-4 md:gap-6 py-5 px-2 -mx-2 group hover:bg-[var(--color-muted)]/60 transition-colors"
          >
            <span class="font-display font-semibold text-[var(--color-primary)] tabular-nums w-10 shrink-0">
              {String(i + 1).padStart(3, '0')}
            </span>
            <h2 class="flex-1 min-w-0 font-display font-semibold text-lg md:text-xl leading-snug group-hover:text-[var(--color-primary)] transition-colors line-clamp-1">
              {post.data.title}
            </h2>
            <span class="hidden sm:block font-sans text-xs text-[var(--color-muted-foreground)] shrink-0">
              {post.data.category} · {fmtDate(post.data.pubDate)}
            </span>
          </a>
        </li>
      ))}
    </ol>

    {posts.length === 0 && (
      <div class="text-center py-20">
        <p class="text-[var(--color-muted-foreground)]">暂无文章</p>
      </div>
    )}
  </section>
</BaseLayout>

<script is:inline data-astro-rerun>
  // 分类索引
  const filterButtons = document.querySelectorAll('.category-filter');
  const postItems = document.querySelectorAll('.post-item');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category');

      filterButtons.forEach(btn => {
        btn.classList.remove('text-[var(--color-primary)]');
        btn.classList.add('text-[var(--color-muted-foreground)]');
      });
      button.classList.remove('text-[var(--color-muted-foreground)]');
      button.classList.add('text-[var(--color-primary)]');

      postItems.forEach(item => {
        item.style.display =
          category === 'all' || item.getAttribute('data-category') === category ? '' : 'none';
      });
    });
  });
</script>
