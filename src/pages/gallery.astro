---
import BaseLayout from '../layouts/BaseLayout.astro';

const photos = [
  // 人物
  { id: 1, title: '坤坤', category: '人物', src: '/gallery/ikun.webp' },
  { id: 2, title: 'KennyS', category: '人物', src: '/gallery/KennyS.webp' },
  { id: 3, title: '4F', category: '人物', src: '/gallery/4F.webp' },
  { id: 4, title: 'yc', category: '人物', src: '/gallery/yc.webp' },
  { id: 5, title: '拐子', category: '人物', src: '/gallery/拐子.webp' },
  { id: 6, title: '老爹精神', category: '人物', src: '/gallery/老爹精神.webp' },
  // 合影
  { id: 7, title: '合照', category: '合影', src: '/gallery/合照.webp' },
  { id: 8, title: '情歌', category: '合影', src: '/gallery/情歌.webp' },
  { id: 9, title: '三姊妹', category: '合影', src: '/gallery/三姊妹.webp' },
  { id: 10, title: '来财和妹妹', category: '合影', src: '/gallery/来财和妹妹.webp' },
  // 回忆
  { id: 11, title: '爷爷年轻照', category: '回忆', src: '/gallery/爷爷年轻照.webp' },
  { id: 12, title: '故宫', category: '回忆', src: '/gallery/故宫.webp' },
];

// 相册章节（保留原顺序）
const chapterOrder = ['人物', '合影', '回忆'];
const chapters = chapterOrder
  .map(cat => ({ cat, items: photos.filter(p => p.category === cat) }))
  .filter(ch => ch.items.length > 0);
---

<BaseLayout title="画册">
  <section class="max-w-5xl mx-auto px-6 py-16 md:py-20">
    <div class="flex items-baseline justify-between mb-3">
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight">相册</h1>
      <p class="tag text-[var(--color-muted-foreground)]">用镜头记录美好的瞬间</p>
    </div>
    <p class="text-[var(--color-muted-foreground)] font-serif mb-14">
      一些照片，和一些记得住的日子。
    </p>

    <!-- 分节相册 -->
    <div class="space-y-20">
      {chapters.map(chapter => (
        <section>
          <div class="flex items-center gap-4 mb-8">
            <h2 class="font-display font-bold text-2xl tracking-tight">{chapter.cat}</h2>
            <div class="h-px flex-1 bg-[var(--color-border)]"></div>
            <span class="tag text-[var(--color-muted-foreground)]">{chapter.items.length} 张</span>
          </div>

          <div class="columns-1 sm:columns-2 md:columns-3 gap-4 space-y-4" id="photo-grid">
            {chapter.items.map(photo => (
              <div
                class="photo-item break-inside-avoid group cursor-pointer"
                data-src={photo.src}
                data-title={photo.title}
              >
                <div class="relative overflow-hidden border border-[var(--color-border)] bg-[var(--color-muted)]">
                  <img
                    src={photo.src}
                    alt={photo.title}
                    class="w-full h-auto object-cover group-hover:opacity-80 transition-opacity duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                  <!-- 图注：编号 + 标题 -->
                  <div class="absolute inset-x-0 bottom-0 flex items-center justify-between px-3 py-2 bg-[var(--color-foreground)]/85 text-[var(--color-background)] opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <span class="font-sans text-xs">{String(photo.id).padStart(2, '0')} · {photo.title}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 items-center justify-center bg-black/90 backdrop-blur-sm"
    style="display: none;"
  >
    <button
      id="lightbox-close"
      class="absolute top-6 right-6 text-white/80 hover:text-white transition-colors"
      aria-label="关闭"
    >
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain" />
    <div id="lightbox-title" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white font-display text-xl"></div>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxClose = document.getElementById('lightbox-close');

  document.querySelectorAll('.photo-item').forEach(item => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src');
      const title = item.getAttribute('data-title');
      if (lightboxImg && src) lightboxImg.src = src;
      if (lightboxTitle && title) lightboxTitle.textContent = title;
      if (lightbox) {
        lightbox.style.display = 'flex';
      }
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.style.display = 'none';
    }
    document.body.style.overflow = '';
  }

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
