---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos, photoChapters } from '../data/photos';
import { ArrowUpRight, ArrowLeft, ArrowRight, X } from 'lucide-astro';
---
<BaseLayout title="相册" description="卢仕潇的个人相册：路上的风景，熟悉的面孔，记得住的日子。">
  <div class="page-wrap">
    <header class="page-heading"><span class="eyebrow">THE PHOTO DIARY</span><h1>光影里，都是生活</h1><p>一些照片，和一些记得住的日子。</p></header>
    <nav class="chapter-nav" aria-label="相册分类">{photoChapters.map(chapter => <a href={'#' + chapter.id}>{chapter.name}<span>{photos.filter(photo => photo.category === chapter.name).length}</span></a>)}</nav>
    <photo-gallery>
      {photoChapters.map(chapter => <section class="photo-chapter" id={chapter.id}>
        <div class="section-heading"><h2>{chapter.name}</h2><span class="eyebrow">{photos.filter(photo => photo.category === chapter.name).length} 张照片</span></div>
        <div class="photo-grid">{photos.filter(photo => photo.category === chapter.name).map(photo => <figure>
          <a class="photo-item" href={photo.src} data-src={photo.src} data-title={photo.title} aria-label={'查看照片：' + photo.title}>
            <img src={photo.src} alt={photo.title} loading="lazy" decoding="async" />
            <figcaption><span>{photo.title}</span><ArrowUpRight size={16} /></figcaption>
          </a>
        </figure>)}</div>
      </section>)}
      <dialog id="lightbox" aria-label="照片浏览" aria-describedby="lightbox-title">
        <div class="lightbox-toolbar"><span id="lightbox-counter"></span><button class="lightbox-button" id="lightbox-close" aria-label="关闭照片" title="关闭照片"><X /></button></div>
        <div class="lightbox-stage">
          <img id="lightbox-img" alt="" decoding="async" draggable="false" />
          <button class="lightbox-button lightbox-arrow lightbox-prev" id="lightbox-prev" aria-label="上一张照片" title="上一张照片"><ArrowLeft /></button>
          <button class="lightbox-button lightbox-arrow lightbox-next" id="lightbox-next" aria-label="下一张照片" title="下一张照片"><ArrowRight /></button>
        </div>
        <p id="lightbox-title" aria-live="polite"></p>
      </dialog>
    </photo-gallery>
  </div>
</BaseLayout>
<style>
  photo-gallery { display: block; }
  .chapter-nav { display: flex; gap: 32px; border-bottom: 1px solid var(--color-border); padding-bottom: 22px; font-size: 14px; }
  .chapter-nav a { display: flex; gap: 9px; }
  .chapter-nav span { color: var(--color-muted-foreground); font-size: 11px; }
  .chapter-nav a:hover { color: var(--color-primary); }
  .photo-chapter { padding-top: 42px; }
  .photo-grid { columns: 3; column-gap: 24px; }
  figure { break-inside: avoid; margin-bottom: 28px; }
  .photo-item { display: block; }
  .photo-item img { width: 100%; height: auto; border-radius: 4px; background: var(--color-muted); }
  .photo-item:hover img { opacity: .9; }
  figcaption { display: flex; justify-content: space-between; gap: 12px; align-items: center; padding-top: 10px; font-size: 13px; }
  figcaption svg { color: var(--color-primary); }
  #travel .photo-grid { columns: 2; }
  /* 大图浏览：图片铺满可用区域，箭头与标题叠在图上，不再挤压图片宽度 */
  dialog {
    position: fixed; inset: 0;
    padding: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none;
    background: #0e1311; color: #f4f7f5; border: 0; margin: 0; overflow: hidden;
  }
  dialog[open] { display: flex; flex-direction: column; }
  dialog::backdrop { background: #0e1311; }
  .lightbox-stage { position: relative; flex: 1; min-height: 0; }
  /* 元素盒铺满舞台，照片用 contain 等比完整显示（不会被裁切，也不溢出容器） */
  .lightbox-stage img {
    position: absolute; inset: 0;
    display: block; width: 100%; height: 100%;
    object-fit: contain;
    -webkit-user-select: none; user-select: none;
    -webkit-touch-callout: none;
  }
  .lightbox-toolbar {
    position: absolute; top: 0; left: 0; right: 0; z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 14px;
    padding-top: calc(10px + env(safe-area-inset-top, 0px));
    background: linear-gradient(to bottom, rgba(14,19,17,.72), rgba(14,19,17,0));
    pointer-events: none;
  }
  .lightbox-toolbar > * { pointer-events: auto; }
  #lightbox-counter { font-family: var(--font-mono); font-size: 12px; opacity: .85; }
  #lightbox-title {
    position: absolute; bottom: 0; left: 0; right: 0; z-index: 2; margin: 0;
    padding: 22px 18px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    text-align: center; font-size: 15px;
    background: linear-gradient(to top, rgba(14,19,17,.78), rgba(14,19,17,0));
  }
  .lightbox-button {
    width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%;
    flex-shrink: 0; color: inherit;
  }
  .lightbox-button:hover { background: #34423b; }
  .lightbox-button:focus-visible { outline-color: white; }
  /* 箭头浮在图片两侧，不占图片宽度 */
  .lightbox-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(20,28,25,.5);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    border: 1px solid rgba(244,247,245,.16);
  }
  .lightbox-arrow:hover { background: rgba(52,66,59,.85); }
  .lightbox-prev { left: max(10px, env(safe-area-inset-left, 0px)); }
  .lightbox-next { right: max(10px, env(safe-area-inset-right, 0px)); }
  @media (max-width: 700px) {
    .photo-grid { columns: 2; column-gap: 16px; }
    #travel .photo-grid { columns: 1; }
    .chapter-nav { gap: 24px; font-size: 13px; }
    .lightbox-button { width: 40px; height: 40px; }
    #lightbox-title { font-size: 14px; }
  }
  @media (max-width: 380px) { .chapter-nav { gap: 18px; } }
</style>
<script>
  class PhotoGallery extends HTMLElement {
    private controller?: AbortController;
    private previousOverflow = '';
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const items = Array.from(this.querySelectorAll<HTMLAnchorElement>('.photo-item'));
      const dialog = this.querySelector<HTMLDialogElement>('#lightbox')!;
      const image = this.querySelector<HTMLImageElement>('#lightbox-img')!;
      let index = 0;
      // 预加载相邻图片，滑动/点箭头时不用等
      const preload = (i: number) => {
        const item = items[(i + items.length) % items.length];
        if (!item) return;
        const img = new Image();
        img.src = item.dataset.src!;
      };
      const show = (next: number) => {
        index = (next + items.length) % items.length;
        image.src = items[index].dataset.src!;
        image.alt = items[index].dataset.title!;
        this.querySelector('#lightbox-title')!.textContent = image.alt;
        this.querySelector('#lightbox-counter')!.textContent = (index + 1) + ' / ' + items.length;
        preload(index + 1);
        preload(index - 1);
      };
      items.forEach((item, i) => item.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        show(i);
        this.previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
      }, { signal }));
      this.querySelector('#lightbox-close')!.addEventListener('click', () => dialog.close(), { signal });
      this.querySelector('#lightbox-prev')!.addEventListener('click', () => show(index - 1), { signal });
      this.querySelector('#lightbox-next')!.addEventListener('click', () => show(index + 1), { signal });
      dialog.addEventListener('keydown', event => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1); }
      }, { signal });
      // 手机端左右滑动切换照片
      let touchX = 0; let touchY = 0; let touching = false;
      dialog.addEventListener('touchstart', event => {
        const touch = event.changedTouches[0];
        touchX = touch.clientX; touchY = touch.clientY; touching = true;
      }, { signal, passive: true });
      dialog.addEventListener('touchend', event => {
        if (!touching) return;
        touching = false;
        const touch = event.changedTouches[0];
        const dx = touch.clientX - touchX;
        const dy = touch.clientY - touchY;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) show(index + (dx < 0 ? 1 : -1));
      }, { signal, passive: true });
      dialog.addEventListener('close', () => { document.body.style.overflow = this.previousOverflow; }, { signal });
    }
    disconnectedCallback() {
      if (this.querySelector<HTMLDialogElement>('dialog')?.open) document.body.style.overflow = this.previousOverflow;
      this.controller?.abort();
    }
  }
  if (!customElements.get('photo-gallery')) customElements.define('photo-gallery', PhotoGallery);
</script>
