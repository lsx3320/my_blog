---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { readPublicImage } from '../lib/local-image.mjs';
import { contentImageUrl } from '../lib/image-cdn.mjs';

const allMoments = await getCollection('moments');
const moments = allMoments.sort((a, b) => {
  const da = a.data.date?.valueOf() ?? Infinity;
  const db = b.data.date?.valueOf() ?? Infinity;
  if (da === db) return 0;
  if (da === Infinity) return -1;
  if (db === Infinity) return 1;
  return db - da;
});
---

<BaseLayout title="朋友圈">
  <section class="max-w-3xl mx-auto px-6 py-16 md:py-20">
    <div class="flex items-baseline justify-between mb-3">
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight">朋友圈</h1>
      <p class="tag text-[var(--color-muted-foreground)]">记录生活里的瞬间</p>
    </div>
    <p class="text-[var(--color-muted-foreground)] font-serif mb-14">
      一些值得留下的瞬间。
    </p>

    <!-- 图录条目 -->
    <div class="space-y-14">
      {moments.map(async (moment) => {
        const { Content } = await render(moment);
        const formattedDate = moment.data.date?.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        const sized = await Promise.all((moment.data.images ?? []).map(async (src, index) => {
          const size = await readPublicImage(src);
          const custom = moment.data.imageAlts?.[index]?.trim();
          const alt = custom || (moment.data.location ? `${moment.data.location}的照片 ${index + 1}` : `动态照片 ${index + 1}`);
          return { src: contentImageUrl(src), alt, width: size?.width, height: size?.height };
        }));

        return (
          <article class="border-b border-[var(--color-border)] pb-14 last:border-0">
            <!-- 日期与位置 -->
            <div class="flex items-center gap-3 font-sans text-xs text-[var(--color-muted-foreground)] mb-5">
              {formattedDate && <time>{formattedDate}</time>}
              {moment.data.location && (
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {moment.data.location}
                </span>
              )}
            </div>

            <!-- 文字 -->
            <div class="font-serif text-[var(--color-foreground)] leading-relaxed mb-6">
              <Content />
            </div>

            <!-- 图片 -->
            {sized.length > 0 && (
              <div class="mb-6">
                {sized.length === 1 ? (
                  <div class="max-w-[320px] overflow-hidden rounded-lg">
                    <button type="button" class="moment-zoom" aria-label={'放大照片：' + sized[0].alt}>
                      <img src={sized[0].src} alt={sized[0].alt} width={sized[0].width} height={sized[0].height} class="moment-img w-full h-auto hover:opacity-90 transition-opacity" loading="lazy" decoding="async" />
                    </button>
                  </div>
                ) : (
                  <div class={`grid gap-2 max-w-[400px] ${
                    sized.length === 2 ? 'grid-cols-2' :
                    sized.length === 4 ? 'grid-cols-2' :
                    'grid-cols-3'
                  }`}>
                    {sized.map((image) => (
                      <div class="aspect-square overflow-hidden rounded-lg">
                        <button type="button" class="moment-zoom" aria-label={'放大照片：' + image.alt}>
                          <img src={image.src} alt={image.alt} width={image.width} height={image.height} class="moment-img w-full h-full object-cover hover:opacity-90 transition-opacity" loading="lazy" decoding="async" />
                        </button>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}

            <!-- 点赞 -->
            <div class="flex items-center gap-4">
              <button type="button" class="like-btn flex items-center gap-1.5 font-sans text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-primary)] transition-colors" data-likes={moment.data.likes} aria-pressed="false" aria-label={`点赞，当前 ${moment.data.likes} 人`}>
                <svg class="w-4 h-4 heart-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span class="like-count">{moment.data.likes}</span>
              </button>
            </div>
          </article>
        );
      })}
    </div>

    {moments.length === 0 && (
      <div class="text-center py-20">
        <p class="text-[var(--color-muted-foreground)]">暂无动态</p>
      </div>
    )}
  </section>

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="放大的照片" class="fixed inset-0 z-[100] bg-black/90 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
    <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[90vh] object-contain scale-90 transition-transform duration-300" />
    <button id="lightbox-close" type="button" aria-label="关闭照片" class="absolute top-4 right-4 w-11 h-11 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  // Lightbox 打开/关闭
  function openLightbox(src, alt) {
    const lightboxImg = document.getElementById('lightbox-img');
    const lightbox = document.getElementById('lightbox');
    if (!lightboxImg || !lightbox) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt || '放大后的动态照片';
    lightbox.classList.remove('opacity-0', 'pointer-events-none');
    lightbox.setAttribute('aria-hidden', 'false');
    lightboxImg.classList.remove('scale-90');
    lightboxImg.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
    document.getElementById('lightbox-close')?.focus();
  }

  function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    lightbox?.classList.add('opacity-0', 'pointer-events-none');
    lightbox?.setAttribute('aria-hidden', 'true');
    lightboxImg?.classList.remove('scale-100');
    lightboxImg?.classList.add('scale-90');
    if (lightboxImg) lightboxImg.alt = '';
    document.body.style.overflow = '';
  }

  // 绑定当前页面的图片点击与点赞（astro:page-load 每次导航后都会执行，
  // 保证 SPA 跳转后新页面的图片灯箱 / 点赞依然可用）
  function bindMoments() {
    document.querySelectorAll('.moment-zoom').forEach(btn => {
      if (btn.__bound) return;
      btn.__bound = true;
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        if (!img) return;
        openLightbox(img.currentSrc || img.src, img.alt);
      });
    });

    document.querySelectorAll('.like-btn').forEach(btn => {
      if (btn.__bound) return;
      btn.__bound = true;
      btn.addEventListener('click', () => {
        const countEl = btn.querySelector('.like-count');
        const heartSvg = btn.querySelector('svg');
        let count = parseInt(countEl.textContent || '0');

        if (btn.classList.contains('liked')) {
          count--;
          btn.classList.remove('liked');
        } else {
          count++;
          btn.classList.add('liked');
          heartSvg.classList.add('scale-125');
          setTimeout(() => heartSvg.classList.remove('scale-125'), 200);
        }

        countEl.textContent = String(count);
        const liked = btn.classList.contains('liked');
        btn.setAttribute('aria-pressed', liked ? 'true' : 'false');
        btn.setAttribute('aria-label', (liked ? '取消点赞，当前 ' : '点赞，当前 ') + count + ' 人');
      });
    });
  }

  // 关闭操作用 document 事件委托（不受 SPA 导航元素替换影响），全局单例防重复
  if (!window.__momentsGlobalBound) {
    window.__momentsGlobalBound = true;
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (t && t.id === 'lightbox') closeLightbox();
      if (t && t.closest && t.closest('#lightbox-close')) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  }

  document.addEventListener('astro:page-load', bindMoments);
  bindMoments();
</script>

<style>
  .moment-zoom { display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .like-btn {
    -webkit-tap-highlight-color: transparent;
    min-width: 44px;
    min-height: 44px;
  }

  .heart-icon {
    transition: transform 0.2s ease;
    fill: none;
    stroke: currentColor;
  }

  .like-btn.liked {
    color: #c23b22;
  }

  .like-btn.liked .heart-icon {
    fill: #c23b22;
    stroke: #c23b22;
  }
</style>
