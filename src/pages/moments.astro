---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const allMoments = await getCollection('moments');
const moments = allMoments.sort((a, b) => {
  const da = a.data.date?.valueOf() ?? Infinity;
  const db = b.data.date?.valueOf() ?? Infinity;
  if (da === db) return 0;
  if (da === Infinity) return -1;
  if (db === Infinity) return 1;
  return db - da;
});
---

<BaseLayout title="图录">
  <section class="max-w-3xl mx-auto px-6 py-16 md:py-20">
    <div class="flex items-baseline justify-between mb-3">
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight">朋友圈</h1>
      <p class="tag text-[var(--color-muted-foreground)]">记录生活里的瞬间</p>
    </div>
    <p class="text-[var(--color-muted-foreground)] font-serif mb-14">
      一些值得留下的瞬间。
    </p>

    <!-- 图录条目 -->
    <div class="space-y-14">
      {moments.map(async (moment) => {
        const { Content } = await render(moment);
        const formattedDate = moment.data.date?.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });

        return (
          <article class="border-b border-[var(--color-border)] pb-14 last:border-0">
            <!-- 日期与位置 -->
            <div class="flex items-center gap-3 font-sans text-xs text-[var(--color-muted-foreground)] mb-5">
              {formattedDate && <time>{formattedDate}</time>}
              {moment.data.location && (
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {moment.data.location}
                </span>
              )}
            </div>

            <!-- 文字 -->
            <div class="font-serif text-[var(--color-foreground)] leading-relaxed mb-6">
              <Content />
            </div>

            <!-- 图片 -->
            {moment.data.images && moment.data.images.length > 0 && (
              <div class="mb-6">
                {moment.data.images.length === 1 ? (
                  <div class="overflow-hidden cursor-pointer border border-[var(--color-border)]">
                    <img src={moment.data.images[0]} alt={moment.data.location || '动态图片'} class="moment-img w-full h-auto hover:opacity-90 transition-opacity" loading="lazy" decoding="async" />
                  </div>
                ) : (
                  <div class={`grid gap-2 ${
                    moment.data.images.length === 2 ? 'grid-cols-2' :
                    moment.data.images.length === 4 ? 'grid-cols-2' :
                    'grid-cols-3'
                  }`}>
                    {moment.data.images.map((img: string) => (
                      <div class="aspect-square overflow-hidden cursor-pointer border border-[var(--color-border)]">
                        <img src={img} alt={moment.data.location || '动态图片'} class="moment-img w-full h-full object-cover hover:opacity-90 transition-opacity" loading="lazy" decoding="async" />
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}

            <!-- 点赞 -->
            <div class="flex items-center gap-4">
              <button class="like-btn flex items-center gap-1.5 font-sans text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-primary)] transition-colors" data-likes={moment.data.likes}>
                <svg class="w-4 h-4 heart-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span class="like-count">{moment.data.likes}</span>
              </button>
            </div>
          </article>
        );
      })}
    </div>

    {moments.length === 0 && (
      <div class="text-center py-20">
        <p class="text-[var(--color-muted-foreground)]">暂无动态</p>
      </div>
    )}
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-black/90 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
    <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[90vh] object-contain scale-90 transition-transform duration-300" />
    <button id="lightbox-close" class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxClose = document.getElementById('lightbox-close');

  function openLightbox(src) {
    lightboxImg.src = src;
    lightbox?.classList.remove('opacity-0', 'pointer-events-none');
    lightboxImg.classList.remove('scale-90');
    lightboxImg.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.add('opacity-0', 'pointer-events-none');
    lightboxImg.classList.remove('scale-100');
    lightboxImg.classList.add('scale-90');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.moment-img').forEach(img => {
    img.addEventListener('click', () => openLightbox(img.src));
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  lightboxClose?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  // 点赞
  document.querySelectorAll('.like-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const countEl = btn.querySelector('.like-count');
      const heartSvg = btn.querySelector('svg');
      let count = parseInt(countEl.textContent || '0');

      if (btn.classList.contains('liked')) {
        count--;
        btn.classList.remove('liked');
      } else {
        count++;
        btn.classList.add('liked');
        heartSvg.classList.add('scale-125');
        setTimeout(() => heartSvg.classList.remove('scale-125'), 200);
      }

      countEl.textContent = String(count);
    });
  });
</script>

<style>
  .like-btn {
    -webkit-tap-highlight-color: transparent;
  }

  .heart-icon {
    transition: transform 0.2s ease;
    fill: none;
    stroke: currentColor;
  }

  .like-btn.liked {
    color: #c23b22;
  }

  .like-btn.liked .heart-icon {
    fill: #c23b22;
    stroke: #c23b22;
  }
</style>
