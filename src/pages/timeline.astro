---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { timelineEvents } from '../data/timeline';
import { ArrowLeft } from 'lucide-astro';
---
<BaseLayout title="成长记录" description="从初到武汉，到探索 AI、走过新疆。卢仕潇的成长记录。">
  <div class="page-wrap timeline-page">
    <header class="page-heading"><a class="text-link" href="/"><ArrowLeft />回到首页</a><h1>来时的路</h1><p>一些转折，一些相遇。2021 年以来的成长记录。</p></header>
    <Timeline events={timelineEvents} />
  </div>
</BaseLayout>
<style>.timeline-page { max-width: 800px; } .page-heading h1 { margin-top: 24px; }</style>
