---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowUpRight, Languages, Volume2, FileText, Lock } from 'lucide-astro';

const BIN_ID = '6aa92c68ac6210605acfe457';
const BIN_URL = `https://api.jsonbin.io/v3/b/${BIN_ID}/latest`;
---
<BaseLayout title="论文阅读" description="把英文论文变成中英对照、可朗读的阅读材料：上传 PDF，逐段翻译并保留术语，支持全文语音播报。">
  <div class="page-wrap">
    <header class="page-heading">
      <span class="eyebrow">PAPER READER</span>
      <h1>把论文读成自己的语言</h1>
      <p>上传一篇英文论文，得到中英对照的逐段译文，还能让 AI 把它读给你听。</p>
    </header>

    <section class="paper-hero" aria-labelledby="paper-enter">
      <div class="paper-actions">
        <a id="paper-enter" class="paper-btn" href="/paper-app/" aria-describedby="paper-status">
          <span>进入论文阅读器</span>
          <ArrowUpRight size={17} />
        </a>
        <p id="paper-status" class="paper-status" role="status">正在检查服务状态…</p>
      </div>

      <ul class="paper-features">
        <li>
          <FileText size={18} />
          <div><strong>上传即译</strong><span>PDF 自动切片，逐段流式翻译，公式与引用原样保留</span></div>
        </li>
        <li>
          <Languages size={18} />
          <div><strong>中英对照</strong><span>左右双语排版，可导出双语 Markdown，术语表统一译名</span></div>
        </li>
        <li>
          <Volume2 size={18} />
          <div><strong>全文朗读</strong><span>按段落合成语音、边听边读，默认 1.5 倍速，可调进度</span></div>
        </li>
      </ul>

      <p class="paper-note">
        <Lock size={14} />
        这是一个私人工具，需要访问口令才能使用；论文与译文只存在我自己的机器上。
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .paper-hero { border-top: 1px solid var(--color-border); padding-top: 34px; }
  .paper-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .paper-btn {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 12px 22px; border-radius: 999px;
    background: var(--color-primary); color: var(--color-background);
    font-family: var(--font-sans); font-size: 15px;
    transition: opacity .2s, transform .15s;
  }
  .paper-btn:hover { opacity: .9; transform: translateY(-1px); }
  .paper-btn[aria-disabled="true"] { opacity: .45; pointer-events: none; }
  .paper-status { margin: 0; font-family: var(--font-mono); font-size: 12px; color: var(--color-muted-foreground); }
  .paper-features { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 18px; }
  .paper-features li { display: flex; gap: 14px; align-items: flex-start; }
  .paper-features svg { color: var(--color-primary); flex-shrink: 0; margin-top: 3px; }
  .paper-features strong { display: block; font-size: 15px; font-weight: 600; }
  .paper-features span { display: block; margin-top: 3px; font-size: 14px; color: var(--color-muted-foreground); }
  .paper-note {
    display: flex; align-items: center; gap: 8px;
    margin: 36px 0 0; padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: 13px; color: var(--color-muted-foreground);
  }
  @media (min-width: 720px) {
    .paper-features { grid-template-columns: repeat(3, 1fr); gap: 26px; }
  }
</style>

<script is:inline data-astro-rerun>
  // 入口固定在 /paper-app/（由 Pages Function 代理到家里机器上的服务），
  // 这里只探测后端是否在线，并给出提示。
  (function () {
    async function checkStatus() {
      const btn = document.getElementById('paper-enter');
      const status = document.getElementById('paper-status');
      if (!btn || !status) return;
      status.textContent = '正在检查服务状态…';
      btn.removeAttribute('aria-disabled');
      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 12000);
        const res = await fetch('/paper-app/api/health', { cache: 'no-store', signal: ctrl.signal });
        clearTimeout(timer);
        if (res.status === 503) throw new Error('offline');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const tts = data?.config?.tts?.ready ?? data?.tts_ready;
        status.textContent = '在线 · 翻译模型 ' + (data?.config?.model || 'deepseek-chat')
          + (tts === false ? ' · 语音未就绪' : ' · 语音就绪');
      } catch (e) {
        btn.setAttribute('aria-disabled', 'true');
        status.textContent = '离线：家里的服务未启动或隧道正在重连，稍后刷新本页';
      }
    }
    document.addEventListener('astro:page-load', checkStatus);
    checkStatus();
  })();
</script>
