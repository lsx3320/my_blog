---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="查无此页">
  <section class="max-w-4xl mx-auto px-6 py-32 text-center">
    <p class="tag text-[var(--color-primary)] mb-6">404 · 本页未刊印</p>
    <h1 class="font-display font-bold text-7xl md:text-9xl text-[var(--color-foreground)] mb-6 tracking-tight">
      查无此页
    </h1>
    <p class="text-xl text-[var(--color-muted-foreground)] font-serif mb-10">
      抱歉，你访问的页面不存在——它可能从未印行，或已绝版。
    </p>
    <a
      href="/"
      class="inline-flex items-center px-6 py-3 border border-[var(--color-foreground)] text-[var(--color-foreground)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-colors font-sans text-sm"
    >
      返回封面
    </a>
  </section>
</BaseLayout>
