{
  "name": "memo-card",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "express": "^5",
    "html-to-image": "^1.11.13",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "concurrently": "^9",
    "vite": "^7"
  }
}
